        <mxCell id="nJEiFrXR9YowHT6csJkn-9" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Auditor Lead&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Es una plataforma que te permitirá acelerar tus ciclos de evaluación de aplicaciones y servicicios en cumplimiento de la norma ISO27001 con un conjunto de artefactos, reportes y análisis agilizando los ciclos de evaluacion y certificación.&lt;/font&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="710" x="145" y="110" as="geometry" />
        </mxCell>
        <mxCell id="nJEiFrXR9YowHT6csJkn-10" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Auditorias&lt;/h1&gt;&lt;p&gt;En esta sección podrás dar seguimiento a los proyectos de auditoria para una o más cargas de trabajao, por empresa o por aplicación.&lt;/p&gt;" vertex="1">
          <mxGeometry height="170" width="365" x="490" y="270" as="geometry" />
        </mxCell>
        <mxCell id="nJEiFrXR9YowHT6csJkn-11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcccc;strokeColor=none;fontStyle=1;fontSize=14;" value="Audtorias" vertex="1">
