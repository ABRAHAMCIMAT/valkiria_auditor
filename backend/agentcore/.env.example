# ─────────────────────────────────────────────────────────────────────────────
# AgentCore Multi-Agent ISO 27001 Audit System — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# AWS Region
AWS_REGION=us-east-1

# Bedrock Knowledge Base (RAG)
KNOWLEDGE_BASE_ID=XXXXXXXXXX
GENERATION_MODEL_ID=amazon.nova-pro-v1:0
MODEL_ID=us.amazon.nova-pro-v1:0
MODEL_TEMPERATURE=0.2
MODEL_MAX_TOKENS=4096
RAG_NUMBER_OF_RESULTS=5

# AgentCore Memory (created via: agentcore memory create <name> --wait)
AGENTCORE_MEMORY_ID=

# AgentCore Gateway (MCP tool routing)
GATEWAY_MCP_URL=
GATEWAY_CLIENT_ID=
GATEWAY_CLIENT_SECRET=
GATEWAY_TOKEN_ENDPOINT=
GATEWAY_SCOPE=AuditGateway/invoke

# S3 Bucket
BUCKET_NAME=iso27001-compliance-rag-XXXXXXXXXXXX

# DynamoDB Tables
DOCUMENTS_TABLE=Documents
AUDITS_TABLE=Audits
FINDINGS_TABLE=AuditFindings

# Sub-Agent Endpoints (local dev)
PLANNING_AGENT_ENDPOINT=http://localhost:8081/invocations
EVIDENCE_AGENT_ENDPOINT=http://localhost:8082/invocations
ORG_CONTROLS_AGENT_ENDPOINT=http://localhost:8083/invocations
PEOPLE_CONTROLS_AGENT_ENDPOINT=http://localhost:8084/invocations
TECH_CONTROLS_AGENT_ENDPOINT=http://localhost:8085/invocations

# Local Development Flag
LOCAL_DEV=1
